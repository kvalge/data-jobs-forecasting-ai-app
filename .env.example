# Always required: DATABASE_URL
# LLM mode: LLM_PROVIDER_MODE=openrouter_ollama (default) | ollama_only
#   openrouter_ollama: also requires OPENROUTER_API_KEY, MODEL, FALLBACK_MODEL
#   ollama_only: uses local Ollama only (OPENROUTER_* / MODEL not required)
# Optional: FALLBACK_MODEL2 / FALLBACK_MODEL3 (OpenRouter chain only)
# Latency tip (free tier): put the fastest/smallest model first, e.g.
#   MODEL=nvidia/nemotron-3-nano-30b-a3b:free
#   FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   # leave FALLBACK_MODEL2/3 unset unless you need a third try
# Prefer 2–3 OpenRouter models over 4 when they share free-tier quota.
# Optional Ollama settings (used as fallback in openrouter_ollama, or primary in ollama_only)
# Web: SECRET_KEY (required unless FLASK_ENV=development), FLASK_HOST, FLASK_DEBUG, FLASK_ENV
# PREDICTION_DATA_SOURCE=fake
LLM_PROVIDER_MODE=openrouter_ollama
OPENROUTER_API_KEY=apikey
MODEL=modelname
FALLBACK_MODEL=modelname
FALLBACK_MODEL2=modelname
FALLBACK_MODEL3=modelname
DATABASE_URL=databaseurl
# Long random value required for web unless FLASK_ENV=development (placeholders are rejected).
SECRET_KEY=replace-with-a-long-random-string
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_DEBUG=false
# Max characters of posting text sent to OpenRouter/Ollama (default 100000).
MAX_POSTING_CHARS=100000
# Fail-fast OpenRouter HTTP timeout (seconds). Default 30.
OPENROUTER_TIMEOUT_SECONDS=30
# Cap completion size (OpenRouter max_tokens + Ollama num_predict). Default 1024.
LLM_MAX_TOKENS=1024
# After OpenRouter 429/free-tier, skip remaining OpenRouter models and try Ollama. Default true.
OPENROUTER_SHORTCIRCUIT_ON_RATE_LIMIT=true
# After OpenRouter truncated/non-JSON output, skip remaining models. Default true.
OPENROUTER_SHORTCIRCUIT_ON_PARSE_ERROR=true
# After OpenRouter timeout, skip remaining models and try Ollama sooner. Default true.
OPENROUTER_SHORTCIRCUIT_ON_TIMEOUT=true
# After OpenRouter free-tier / all models fail, try local Ollama (openrouter_ollama mode).
OLLAMA_FALLBACK_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Prefer a smaller model for speed (e.g. llama3.2:latest); qwen3.5 is stronger but slower.
OLLAMA_MODEL=llama3.2:latest
# Code default is 180 when unset; 120 is fine for smaller models.
OLLAMA_TIMEOUT_SECONDS=180
# Keep the model loaded between calls (e.g. 10m, 30m, -1 = forever). Default 10m.
OLLAMA_KEEP_ALIVE=10m
# Only set true if OLLAMA_BASE_URL intentionally points at a non-loopback host.
OLLAMA_ALLOW_REMOTE=false
# Privacy-safe LLM request metadata (no prompts/responses). Default on.
LLM_METADATA_LOG_ENABLED=true
LLM_METADATA_LOG_PATH=logs/llm_requests.ndjson
# Prediction series for CLI default: fake | database (web UI has separate tabs).
PREDICTION_DATA_SOURCE=fake
