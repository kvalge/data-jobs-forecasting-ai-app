# All of these except SECRET_KEY / PREDICTION_DATA_SOURCE are required for CLI and web (non-empty).
# SECRET_KEY is used by the Flask UI for flash messages/sessions.
OPENROUTER_API_KEY=apikey
MODEL=modelname
FALLBACK_MODEL=modelname
DATABASE_URL=databaseurl
SECRET_KEY=change-me-to-a-long-random-string
# Prediction series: fake (data/fake CSVs) or database (not implemented yet).
PREDICTION_DATA_SOURCE=fake
